# Supabase Postgres. Use a role that owns the "app" / "app_test" schemas, not
# "public" (Supabase's Data API exposes public to the anon key).
# Local dev: session pooler (5432). Serverless deploys: transaction pooler,
#   e.g. ...pooler.supabase.com:6543/postgres?schema=app&pgbouncer=true&connection_limit=5&pool_timeout=20
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=app&connection_limit=5"
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=app"
TEST_DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=app_test"

# Optional: the community every new member is placed in (defaults to the oldest).
# DEFAULT_COMMUNITY_SLUG="lakeview"

# Platform admin created by `npm run db:seed` on an empty database.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"

# Resend: verify kindbridge.co.in and add a Sending-only key in Vercel production.
RESEND_API_KEY=""
EMAIL_FROM="KindBridge <noreply@kindbridge.co.in>"
